# Server Configuration
PORT=3000
ENVIRONMENT=development

# Solana Payment Configuration
# Set your Solana recipient wallet address here to receive funds directly.
# The value below is Solana's incinerator (burn) address: SOL sent to it is destroyed.
RECIPIENT_WALLET=1nc1nerator11111111111111111111111111111111
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Pricing Configuration
# Price in SOL per 10,000 API requests
PRICE_SOL_PER_TIER=0.05
# Price in USDC per 10,000 API requests
PRICE_USDC_PER_TIER=5.0
DEFAULT_FREE_CREDITS=100
