{
  "name": "boardcheck-edge",
  "version": "1.0.0",
  "description": "Zero-maintenance edge platform and Remote MCP server for AI agent marketplace auditing with Solana Pay on-chain credits",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "boardcheck-edge": "./bin/boardcheck-edge.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts src/engine/scanner.ts src/engine/types.ts --format esm --dts",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "boardcheck",
    "mcp",
    "model-context-protocol",
    "solana-pay",
    "ai-agents",
    "marketplace-auditing",
    "hono",
    "cloudflare-workers"
  ],
  "author": "Echolonius",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@solana/web3.js": "^1.98.0",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
